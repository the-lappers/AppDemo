# Public Mapbox token (starts with pk.). Restrict it to your site URLs in the Mapbox dashboard.
MAP_BLOCK_KEY=

# Public Longdo Map key (map.longdo.com). Optional: adds a Mapbox | Longdo switch on the chat map.
LONGDO_MAP_KEY=

# Server-side Longdo key for live public transport (walk + BTS/MRT/ARL + ferry) on the home page. Optional.
# It stays on the server: the page only learns TRANSIT=true. The key is locked to a domain; set LONGDO_REFERER if yours is not localhost.
LONGDO_KEY=
# LONGDO_REFERER=http://localhost
# LONGDO_DAILY_MAX=2000

# Vibe search service (the dayoff-search repo: python -m dayoff.api ...). Optional. When it answers, the demo switches to its
# area: its places (map, planner, chat) and its review-based search. Empty or not running = the demo's own places.
SEARCH_API_URL=
# SEARCH_AREA=ratchayothin
